import addOnSandboxSdk from "add-on-sdk-document-sandbox";
import { editor } from "express-document-sdk";

const { runtime } = addOnSandboxSdk.instance;

function extractFontsFromNode(node, fontsSet) {
  if (node.fullContent && node.fullContent.characterStyleRanges) {
    for (const range of node.fullContent.characterStyleRanges) {
      const font = range.font?.postscriptName;
      if (font) fontsSet.add(font);
      console.log("Detected font:", font);
    }
  }
}

async function start() {
  const sandboxApi = {
    checkFontHarmony: async () => {
      try {
        const root = editor.documentRoot;
        const fontsSet = new Set();

        for (const page of root.pages) {
          for (const artboard of page.artboards) {
            for (const node of artboard.allChildren) {
              extractFontsFromNode(node, fontsSet);
              if (node.allChildren) {
                for (const child of node.allChildren) {
                  extractFontsFromNode(child, fontsSet);
                }
              }
            }
          }
        }

        const fontList = [...fontsSet];

        if (fontList.length === 0) {
          return {
            message: "No text elements with fonts detected in the document.",
            fonts: [],
            harmonyScore: 0,
            harmonyExplanation: "No fonts to evaluate.",
            recommendations: []
          };
        }

        // Hardcoded recommendations
        const hardcodedRecs = {
          "PlayfairDisplay-Regular": [
            { font: "Roboto", score: 85, explanation: "Modern sans-serif for contrast." },
            { font: "Lora", score: 80, explanation: "Classic serif pairing well with elegance." },
            { font: "Montserrat", score: 78, explanation: "Strong geometric contrast." }
          ],
          "OldStandardTT-Italic": [
            { font: "Merriweather", score: 82, explanation: "Balances classic style with legibility." },
            { font: "Source Sans Pro", score: 75, explanation: "Simple sans-serif for contrast." },
            { font: "Georgia", score: 70, explanation: "Traditional pairing with similar rhythm." }
          ],
          "PlayfairDisplay-Regu": [
            { font: "Nunito", score: 78, explanation: "Rounded and friendly to balance classic tone." },
            { font: "Open Sans", score: 76, explanation: "Highly readable and safe choice." },
            { font: "Bitter", score: 72, explanation: "Slab serif adds strength to elegance." }
          ]
        };

        const recommendations = fontList.map(font => ({
          font,
          recommendations: hardcodedRecs[font] || [
            { font: "Open Sans", score: 70, explanation: "Fallback default pairing." },
            { font: "Lato", score: 68, explanation: "Neutral, modern choice." },
            { font: "Georgia", score: 65, explanation: "Classic serif fallback." }
          ]
        }));

        // Simple hardcoded harmony score logic
        let harmonyScore = 100;
        let harmonyExplanation = "Single font used; harmony is perfect.";

        if (fontList.length > 1) {
          if (
            fontList.includes("PlayfairDisplay-Regular") &&
            fontList.includes("OldStandardTT-Italic")
          ) {
            harmonyScore = 88;
            harmonyExplanation = "Fonts have compatible serif styles with elegant contrast.";
          } else if (
            fontList.includes("PlayfairDisplay-Regular") &&
            fontList.includes("PlayfairDisplay-Regu")
          ) {
            harmonyScore = 95;
            harmonyExplanation = "Very similar fonts; high consistency, but might feel redundant.";
          } else {
            harmonyScore = 70;
            harmonyExplanation = "Fonts have moderate stylistic contrast.";
          }
        }

        return {
          message: `Detected ${fontList.length} font(s) in the document.`,
          fonts: fontList,
          harmonyScore,
          harmonyExplanation,
          recommendations
        };

      } catch (error) {
        console.log("Error in checkFontHarmony:", error);
        return {
          message: `Error: ${error.message}`,
          fonts: [],
          harmonyScore: 0,
          harmonyExplanation: "No fonts to evaluate.",
          recommendations: []
        };
      }
    }
  };

  runtime.exposeApi(sandboxApi);
}

start();
