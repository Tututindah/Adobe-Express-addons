import addOnUISdk from "https://new.express.adobe.com/static/add-on-sdk/sdk.js";

function debounce(func, wait) {
  let timeout;
  return function (...args) {
    clearTimeout(timeout);
    timeout = setTimeout(() => func.apply(this, args), wait);
  };
}

addOnUISdk.ready.then(async () => {
  console.log("addOnUISdk.ready resolved at", new Date().toLocaleString());
  try {
    const { runtime } = addOnUISdk.instance;
    const sandboxProxy = await runtime.apiProxy("documentSandbox");
    console.log("Sandbox proxy initialized:", sandboxProxy);

    const checkFontsButton = document.getElementById("checkFonts");
    const resultBox = document.getElementById("result");

    if (sandboxProxy.checkFontHarmony) {
      checkFontsButton.disabled = false;
    } else {
      resultBox.textContent = "The checkFontHarmony API is not supported in this environment.";
      checkFontsButton.disabled = true;
      return;
    }

    checkFontsButton.addEventListener("click", debounce(async () => {
      try {
        const result = await sandboxProxy.checkFontHarmony();
        displayResults(result);
      } catch (e) {
        console.error("Error in checkFontHarmony:", e);
        resultBox.textContent = `Error: ${e.message}`;
      }
    }, 500));

    let lastFonts = null;
    const pollSelection = debounce(async () => {
      try {
        const result = await sandboxProxy.checkFontHarmony();
        const fontsChanged =
          !lastFonts ||
          lastFonts.length !== result.fonts.length ||
          lastFonts.some((font, i) => font !== result.fonts[i]);

        if (fontsChanged) {
          console.log("Fonts changed, updating results...");
          displayResults(result);
          lastFonts = result.fonts;
        }
      } catch (e) {
        console.error("Error in pollSelection:", e);
        resultBox.textContent = `Error: ${e.message}`;
      }
    }, 1000); // Poll every 1 second

    setInterval(pollSelection, 1000);

    pollSelection();

    function displayResults(result) {
      if (!result || !result.fonts || result.fonts.length === 0) {
        resultBox.textContent = result.message || "No fonts detected. Please select text elements.";
        return;
      }

      resultBox.innerHTML = `
        <p><strong>Detected Fonts:</strong> ${result.fonts.join(", ")}</p>
        <p><strong>Harmony Score:</strong> ${result.harmonyScore}/100</p>
        <p><strong>Harmony Explanation:</strong> ${result.harmonyExplanation}</p>
        <p><strong>Feedback:</strong> ${result.message}</p>
        ${
          result.recommendations && result.recommendations.length > 0
            ? `
              <p><strong>Recommended Complementary Fonts:</strong></p>
              ${result.recommendations
                .map(
                  (rec) => `
                    <div>
                      <strong>For ${rec.font}:</strong>
                      <ul>
                        ${rec.recommendations
                          .map(
                            (r) => `
                              <li>
                                ${r.font} (Score: ${r.score}/100)<br>
                                ${r.explanation}
                              </li>
                            `
                          )
                          .join("")}
                      </ul>
                    </div>
                  `
                )
                .join("")}
            `
            : "<p>No recommendations available.</p>"
        }
      `;
    }
  } catch (e) {
    console.error("SDK initialization failed:", e);
    document.getElementById("result").textContent = `SDK initialization error: ${e.message}`;
  }
}).catch((e) => {
  console.error("addOnUISdk.ready failed:", e);
  document.getElementById("result").textContent = `SDK initialization error: ${e.message}`;
});